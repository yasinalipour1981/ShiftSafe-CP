# ---------------------------------------------------------------------------
# Public repository of the ShiftSafe-CP / TargetAnchoredJK+ paper.
# Everything needed to re-run the experiments and regenerate every table and
# figure is tracked; manuscript sources, typesetting scripts and bulky
# regenerable artefacts are not.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.egg

# Environment / IDE / OS
.env
.venv/
venv/
env/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Manuscript sources and submission files (not part of the code release)
manuscript/
manuscript - Copy/
manuscript - Copy (2)/
*.docx
*.zip
/*.pdf
CAC+Template-Main Manuscript.docx
/*.md
!/README.md
!/REPOSITORY.md

